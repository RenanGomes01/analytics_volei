# Sincronização do outbox.
#   off      — padrão: nada é enviado, a fila só cresce (dados seguros no IndexedDB + exportação JSON).
#   mock     — envia para um servidor simulado em memória (MockTransport), para desenvolvimento e demo.
#   supabase — nuvem real (Fase 8). Rode antes supabase/migrations/0001_cloud_sync.sql no SQL Editor.
#              Sem URL/chave abaixo, o app cai para "off".
NEXT_PUBLIC_SYNC_MODE=off

# Supabase → Settings → API. A anon key é pública por natureza: quem protege os dados é o RLS.
# Copie este arquivo para .env.local (fora do git) e gere o app de novo (npm run build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dados de teste (/dev/seed). Em produção (next build/start, Vercel) a rota dá 404.
# Para usá-la num servidor local de homologação, descomente no .env.local. Nunca na Vercel.
# ENABLE_DEV_SEED=true
